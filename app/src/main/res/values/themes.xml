<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    
    <style name="Theme.KillWiFi" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/neon_purple</item>
        <item name="colorPrimaryVariant">@color/neon_purple_light</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/neon_blue</item>
        <item name="colorSecondaryVariant">@color/neon_cyan</item>
        <item name="colorOnSecondary">@color/cyber_black</item>
        <item name="android:colorBackground">@color/cyber_black</item>
        <item name="colorSurface">@color/cyber_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/cyber_black</item>
        <item name="android:navigationBarColor">@color/cyber_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/cyber_black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="fontFamily">@font/orbitron_bold</item>
    </style>

    
    <style name="Theme.KillWiFi.Splash" parent="Theme.KillWiFi">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    
    <style name="CyberButton.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:elevation">8dp</item>
    </style>

    
    <style name="CyberButton.Danger" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:elevation">8dp</item>
    </style>

    
    <style name="CyberButton.Ghost" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/neon_purple_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    
    <style name="CyberCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cyber_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">12dp</item>
        <item name="strokeColor">@color/neon_purple</item>
        <item name="strokeWidth">1dp</item>
    </style>

    
    <style name="CyberEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">18sp</item>
        <item name="android:padding">20dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

</resources>