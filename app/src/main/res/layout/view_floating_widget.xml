<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <ImageButton
        android:id="@+id/btnWidgetExpand"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_widget_surface"
        android:contentDescription="Mở menu điều khiển"
        android:padding="16dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="#76E6B0"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widgetMenu"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_widget_surface"
        android:elevation="16dp"
        android:animateLayoutChanges="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO TYPER"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Điều khiển nhanh"
                    android:textColor="#91A4C5"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvWidgetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_status"
                android:text="Sẵn sàng"
                android:textColor="#76E6B0"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="FILE TXT ĐÃ LƯU"
            android:textColor="#91A4C5"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widgetFileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnWidgetAddFile"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4169D8"
            android:text="＋  Thêm file .txt"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">
            <Spinner
                android:id="@+id/spinnerWidgetMode"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1" />
            <EditText
                android:id="@+id/etWidgetDelaySeconds"
                android:layout_width="82dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:hint="1"
                android:inputType="numberDecimal"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#91A4C5"
                android:backgroundTint="#5C79B0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="giây"
                android:textColor="#B7C5DC"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center">
            <ImageButton
                android:id="@+id/btnWidgetStart"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_widget_icon_button"
                android:contentDescription="Bắt đầu"
                android:src="@android:drawable/ic_media_play"
                android:tint="#76E6B0" />
            <ImageButton
                android:id="@+id/btnWidgetPause"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_widget_icon_button"
                android:contentDescription="Tạm dừng hoặc tiếp tục"
                android:src="@android:drawable/ic_media_pause"
                android:tint="#FFD166" />
            <ImageButton
                android:id="@+id/btnWidgetStop"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_widget_icon_button"
                android:contentDescription="Dừng"
                android:src="@android:drawable/ic_media_stop"
                android:tint="#FF7180" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Volume Down ×2 để ẩn/hiện"
                android:textColor="#91A4C5"
                android:textSize="10sp" />
            <ImageButton
                android:id="@+id/btnWidgetCollapse"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_widget_icon_button"
                android:contentDescription="Ẩn menu"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#B7C5DC" />
            <ImageButton
                android:id="@+id/btnWidgetClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_widget_icon_button"
                android:contentDescription="Đóng widget"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#FF7180" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
