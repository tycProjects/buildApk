<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:padding="20dp">

    
    <ImageView
        android:id="@+id/iv_skull"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_skull"
        app:tint="@color/neon_red"
        android:shadowColor="@color/neon_red"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    
    <TextView
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:shadowColor="@color/neon_red"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="20"
        android:fontFamily="monospace"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/iv_skull"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    
    <TextView
        android:id="@+id/tv_main_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_subtitle"
        android:textColor="@color/neon_purple_light"
        android:textSize="12sp"
        android:letterSpacing="0.25"
        android:fontFamily="monospace"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_main_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    
    <androidx.cardview.widget.CardView
        android:id="@+id/card_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        app:cardBackgroundColor="@color/cyber_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/neon_purple"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toBottomOf="@id/tv_main_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_wifi"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/neon_cyan"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_input_label"
                    android:textColor="@color/neon_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:fontFamily="monospace"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            
            <EditText
                android:id="@+id/et_ip_address"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:hint="@string/main_input_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="20sp"
                android:textStyle="bold"
                android:inputType="text"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginTop="14dp"/>

            
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:fontFamily="monospace"
                android:layout_marginTop="14dp"
                android:layout_gravity="end"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    
    <androidx.cardview.widget.CardView
        android:id="@+id/card_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/cyber_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/neon_red"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/card_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_lightning"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lightning"
                    app:tint="@color/neon_yellow"/>

                <TextView
                    android:id="@+id/tv_power_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/main_power_label"
                    android:textColor="@color/neon_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:fontFamily="monospace"
                    android:layout_marginStart="12dp"/>

                <TextView
                    android:id="@+id/tv_power_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/neon_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginTop="12dp">

                <View
                    android:id="@+id/power_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_button_danger"
                    android:scaleX="0"
                    android:transformPivotX="0dp"/>
            </FrameLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_gaskeun"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="@string/main_btn_attack"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:letterSpacing="0.15"
        android:fontFamily="monospace"
        android:background="@drawable/bg_button_danger"
        app:backgroundTint="@null"
        app:cornerRadius="20dp"
        app:elevation="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/card_power"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btn_gaskeun"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/main_btn_settings"
            android:textSize="13sp"
            android:textColor="@color/neon_purple_light"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"
            android:background="@drawable/bg_button_ghost"
            app:backgroundTint="@null"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_about"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/main_btn_about"
            android:textSize="13sp"
            android:textColor="@color/neon_cyan"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"
            android:background="@drawable/bg_button_ghost"
            app:backgroundTint="@null"
            app:cornerRadius="14dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>