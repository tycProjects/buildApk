<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CloudPhone"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnPickFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Files to Zip"/>

    <TextView
        android:id="@+id/selectedCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No files selected"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/fileListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/zipNameEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Output zip file name (e.g. archive.zip)"
        android:text="archive.zip"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnCreateZip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Zip File"
        android:enabled="false"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""/>

</LinearLayout>
