<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" app:scaleType="fillCenter" />
    <View android:id="@+id/blackTop" android:layout_width="match_parent" android:layout_height="115dp" android:background="#55000000" android:layout_gravity="top"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:padding="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/flash" style="@style/TopBtn" android:text="⚡"/><Button android:id="@+id/hdr" style="@style/TopBtn" android:text="HDR"/><Button android:id="@+id/timer" style="@style/TopBtn" android:text="0s"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><Button android:id="@+id/settings" style="@style/TopBtn" android:text="⚙"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:gravity="center_horizontal" android:paddingBottom="22dp" android:background="#66000000">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="58dp" android:scrollbars="none"><LinearLayout android:id="@+id/zoomRow" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="18dp"><Button style="@style/ZoomBtn" android:text="0.5×"/><Button style="@style/ZoomBtn" android:text="1×"/><Button style="@style/ZoomBtn" android:text="2×"/><Button style="@style/ZoomBtn" android:text="3×"/></LinearLayout></HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="105dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="24dp">
            <ImageButton android:id="@+id/gallery" style="@style/CircleBtn" android:src="@android:drawable/ic_menu_gallery" android:contentDescription="Gallery"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <FrameLayout android:layout_width="82dp" android:layout_height="82dp"><Button android:id="@+id/shutter" android:layout_width="78dp" android:layout_height="78dp" android:layout_gravity="center" android:backgroundTint="#FFFFFF" android:text=""/><View android:layout_width="68dp" android:layout_height="68dp" android:layout_gravity="center" android:background="@drawable/shutter_inner" android:clickable="false"/></FrameLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><ImageButton android:id="@+id/switchCamera" style="@style/CircleBtn" android:src="@android:drawable/ic_menu_rotate" android:contentDescription="Switch camera"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingHorizontal="20dp"><TextView android:id="@+id/photoMode" style="@style/ModeText" android:text="PHOTO"/><TextView android:id="@+id/videoMode" style="@style/ModeText" android:text="VIDEO"/><TextView android:id="@+id/portraitMode" style="@style/ModeText" android:text="PORTRAIT"/></LinearLayout></HorizontalScrollView>
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="14dp" android:textColor="#FFFFFF" android:textSize="15sp" android:background="#99000000" android:visibility="gone"/>
</FrameLayout>
