# Personal access token with repo + workflow scopes. Keep this secret —
# never commit the real .env file. This is what authenticates against
# GitHub's API under the hood; renaming this variable will break the
# server unless you also update it in your host's (e.g. Render) env vars.
GITHUB_TOKEN=

# The repo the builder pushes job branches to and dispatches Actions runs
# on, as "owner/repo".
GITHUB_REPO=

# Base branch the workflow file lives on. Defaults to "main".
GITHUB_BRANCH=main

# Workflow filename (must exist under .github/workflows/ on GITHUB_BRANCH
# with a workflow_dispatch trigger). Defaults to "build.yml".
WORKFLOW_FILE=build.yml

PORT=3000
MAX_UPLOAD_MB=200
JOB_TTL_MINUTES=60
