# SAO CHÉP các biến này vào Vercel > Project > Settings > Environment Variables.
# KHÔNG commit giá trị thật vào git. Với `vercel dev` có thể tạo file .env.local.

# --- TMDB (bắt buộc) ---
TMDB_API_KEY=

# --- Ký phiên đăng nhập (bắt buộc nếu dùng tài khoản) ---
# Chuỗi ngẫu nhiên mạnh, ví dụ sinh bằng: openssl rand -hex 32
SESSION_SECRET=

# --- Lưu trữ cho SYNC (chọn Upstash HOẶC Supabase) ---
# 1) Upstash Redis REST — lý tưởng cho serverless (cũng dùng cho rate-limit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase (bắt buộc cho TÀI KHOẢN; cũng có thể làm store cho SYNC) ---
# Lấy tại Supabase > Project Settings > API. PHẢI dùng SERVICE ROLE key
# (bypass RLS, chỉ để ở server — KHÔNG lộ ra frontend).
# Tạo sẵn 2 bảng users/sync bằng SQL trong api/_lib/supabase.js.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- CORS: để rỗng => tự suy ra từ Host hiện tại; hoặc đặt https://ten-mien-cua-ban ---
ALLOWED_ORIGIN=
